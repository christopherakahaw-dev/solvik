{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/forms/**",
              "components/map/**",
              "components/navigation/**",
              "components/transit/**",
              "ui_kits/solvik-app/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo))/i]",
        "message": "Font not provided by the design system. Available: Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppHeader'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|uppercase|action|sticky|style|key|ref|className|style|children)$/]",
        "message": "<AppHeader> doesn't accept that prop. Declared props: title, subtitle, uppercase, action, sticky, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ArrivalRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:destination|levels|crowdSummary|minutes|following|divider|onClick|style|key|ref|className|style|children)$/]",
        "message": "<ArrivalRow> doesn't accept that prop. Declared props: destination, levels, crowdSummary, minutes, following, divider, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: children, tone, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:accent|dark|soft|neutral|warn|alert)$/]",
        "message": "<Badge> tone must be one of 'accent' | 'dark' | 'soft' | 'neutral' | 'warn' | 'alert'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='BottomSheet'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|elevated|grabber|style|key|ref|className|style|children)$/]",
        "message": "<BottomSheet> doesn't accept that prop. Declared props: children, elevated, grabber, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|iconLeft|iconRight|fullWidth|disabled|onClick|type|style|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, iconLeft, iconRight, fullWidth, disabled, onClick, type, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|soft|ghost|dark)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'soft' | 'ghost' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|padding|interactive|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: children, tone, padding, interactive, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|outlined|hairline|accent|dark)$/]",
        "message": "<Card> tone must be one of 'plain' | 'outlined' | 'hairline' | 'accent' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:default|tight|none)$/]",
        "message": "<Card> padding must be one of 'default' | 'tight' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrowdingMeter'] > JSXAttribute > JSXIdentifier[name!=/^(?:levels|summary|showLabel|size|style|key|ref|className|style|children)$/]",
        "message": "<CrowdingMeter> doesn't accept that prop. Declared props: levels, summary, showLabel, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='CrowdingMeter'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<CrowdingMeter> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|color|title|style|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth, color, title, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|label|tone|size|badge|disabled|onClick|style|key|ref|className|style|children)$/]",
        "message": "<IconButton> doesn't accept that prop. Declared props: icon, label, tone, size, badge, disabled, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:plain|soft|accent|ghost)$/]",
        "message": "<IconButton> tone must be one of 'plain' | 'soft' | 'accent' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IconButton'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<IconButton> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MapCanvas'] > JSXAttribute > JSXIdentifier[name!=/^(?:center|zoom|route|marker|height|interactive|style|key|ref|className|style|children)$/]",
        "message": "<MapCanvas> doesn't accept that prop. Declared props: center, zoom, route, marker, height, interactive, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='PromptCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|title|description|actionLabel|onAction|onDismiss|style|key|ref|className|style|children)$/]",
        "message": "<PromptCard> doesn't accept that prop. Declared props: icon, title, description, actionLabel, onAction, onDismiss, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SearchField'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|placeholder|icon|onChange|onClear|onSubmit|style|key|ref|className|style|children)$/]",
        "message": "<SearchField> doesn't accept that prop. Declared props: value, placeholder, icon, onChange, onClear, onSubmit, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SegmentedTabsItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<SegmentedTabsItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|style|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: children, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TabBarItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|label|key|ref|className|style|children)$/]",
        "message": "<TabBarItem> doesn't accept that prop. Declared props: id, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|icon|onClick|style|key|ref|className|style|children)$/]",
        "message": "<Tag> doesn't accept that prop. Declared props: children, tone, icon, onClick, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:soft|outline|neutral|warn)$/]",
        "message": "<Tag> tone must be one of 'soft' | 'outline' | 'neutral' | 'warn'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TogglePill'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|icon|pressed|onChange|fullWidth|style|key|ref|className|style|children)$/]",
        "message": "<TogglePill> doesn't accept that prop. Declared props: children, icon, pressed, onChange, fullWidth, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TripCardTag'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|tone|icon|onClick|key|ref|className|style|children)$/]",
        "message": "<TripCardTag> doesn't accept that prop. Declared props: label, tone, icon, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='TripCardTag'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:soft|outline|neutral|warn)$/]",
        "message": "<TripCardTag> tone must be one of 'soft' | 'outline' | 'neutral' | 'warn'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
