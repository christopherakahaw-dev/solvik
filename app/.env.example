# Copy this file to .env (local dev) or set these in your host's project
# settings (e.g. Vercel > Settings > Environment Variables) for production.
# Values prefixed VITE_ are intentionally compiled into the browser app. Use
# only Supabase's publishable key there, never its service-role key.

# --- Supabase accounts ---
# Project URL and publishable key from Supabase > Connect. The publishable key
# is safe in the browser because the database migration enables row-level
# security on every exposed user-data table.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Server-only values used solely by /api/delete-account. Never prefix the
# service-role key with VITE_ or expose it to client code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- OneMap (Singapore Land Authority) ---
# Search works with no credentials. Routing (turn-by-turn directions) needs
# an authenticated token. Register a free account at
# https://www.onemap.gov.sg/apidocs/register, then set EITHER:
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
# ...or, if you already have a long-lived token, set this instead and skip
# the two above:
# ONEMAP_TOKEN=

# --- LTA DataMall ---
# Request a free AccountKey at https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# --- Map base (OpenStreetMap) ---
# OpenStreetMap is the required geospatial base, and its usage policy forbids
# applications from serving tiles off tile.openstreetmap.org — so OSM is rendered
# through MapTiler, whose free tier needs a key. Get one at
# https://cloud.maptiler.com/account/keys/ (free, no card).
# Without it the map falls back to OneMap's tiles, which are also OSM-derived and
# are credited as such; nothing breaks, but OSM is no longer the primary base.
VITE_MAPTILER_KEY=

# --- Photo check for commuter reports (optional) ---
# Server-only. /api/report sends a report's photo to Claude and asks whether it
# is CONSISTENT with what was reported — never whether the report is true, which
# no model can establish. Without this key the deterministic checks (where you
# are, how precise the fix is, when the shutter fired, your hourly limit) still
# run, and the report says the photo was not checked. Never prefix with VITE_.
# ANTHROPIC_API_KEY=

# --- Demo mode (off by default) ---
# For a stage, a five-minute slot and a venue network nobody controls. With
# this on, a live call that FAILS is answered from recorded data instead of an
# error — and every screen showing it says "Recorded", so nothing is ever
# passed off as live. It also offers a "week of sample trips" button so the
# learned-commute card can be shown without waiting a fortnight.
# Set BOTH: the first is read by api/*.js, the second is compiled into the app.
# DEMO_MODE=1
# VITE_DEMO_MODE=1
